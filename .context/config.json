{
  "$schema": "./schema/config.schema.json",
  // ctx-lint dogfoods itself: CLAUDE.md, .claude/rules and AGENTS.md are generated from .context/rules.
  "targets": {
    "claude": { "enabled": true },
    "agents": { "enabled": true },
    "cursor": { "enabled": false },
    "copilot": { "enabled": false },
    "windsurf": { "enabled": false }
  },
  "check": {
    // The demo and test fixtures contain intentional problems.
    "exclude": ["examples/**", "test/fixtures/**"]
  },
  "audit": { "budget": { "default": 1500 } }
}

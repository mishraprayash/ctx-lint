{
  "name": "ctx-lint",
  "version": "0.1.0",
  "description": "Lint, sync and budget the instruction files of AI coding agents (CLAUDE.md, AGENTS.md, Cursor rules, Copilot instructions).",
  "keywords": [
    "ai",
    "agents",
    "coding-agents",
    "claude",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "windsurf",
    "agents-md",
    "claude-md",
    "linter",
    "lint",
    "cli",
    "context"
  ],
  "homepage": "https://github.com/mishraprayash/ctx-lint#readme",
  "bugs": {
    "url": "https://github.com/mishraprayash/ctx-lint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishraprayash/ctx-lint.git"
  },
  "license": "MIT",
  "author": "Prayash Mishra",
  "type": "module",
  "bin": {
    "ctx-lint": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "docs/rules"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run test/unit",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run test/e2e",
    "coverage": "vitest run test/unit --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "schema": "tsx scripts/generate-schema.ts",
    "calibrate": "tsx scripts/calibrate-tokenizer.ts",
    "bench": "tsx scripts/bench.ts",
    "corpus": "tsx scripts/corpus.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "fastest-levenshtein": "^1.0.16",
    "ignore": "^7.0.12",
    "jsonc-parser": "^3.3.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "gpt-tokenizer": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "gpt-tokenizer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/sarif": "^2.1.7",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "execa": "^10.1.1",
    "gpt-tokenizer": "^4.0.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
